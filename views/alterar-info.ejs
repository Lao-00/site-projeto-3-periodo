<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <title>Alterar Informações - Base 5</title>
        <link rel="stylesheet" href="/css/style.css" />
    </head>
    <body class="cadastro-body">
        <div class="cadastro-container">
            <main class="cadastro-card">
                <h1 style="text-align: center">Alterar Dados</h1>

                <% if (aviso) { %>
                <div class="alerta-erro">
                    <p><%= aviso %></p>
                </div>
                <% } %>

                <% if (etapa === 'escolha') { %>
                <p
                    style="
                        text-align: center;
                        margin-bottom: 20px;
                        font-weight: bold;
                        font-size: 1.1rem;
                    "
                >
                    O que você deseja alterar?
                </p>

                <div style="display: flex; flex-direction: column; gap: 15px; margin-bottom: 25px">
                    <a
                        href="/alterar-info?tipo=email"
                        class="btn-secundario"
                        style="text-align: center; width: 100%; box-sizing: border-box"
                    >
                        Alterar E-mail
                    </a>
                    <a
                        href="/alterar-info?tipo=senha"
                        class="btn-secundario"
                        style="text-align: center; width: 100%; box-sizing: border-box"
                    >
                        Alterar Senha
                    </a>
                </div>

                <div style="text-align: center; display: flex; justify-content: center">
                    <a href="/perfil" class="link-voltar">Voltar para o Perfil</a>
                </div>

                <% } else if (etapa === 'formulario') { %>
                <form action="/alterar-info/solicitar" method="POST" id="form-alterar">
                    <input type="hidden" name="tipoAlteracao" value="<%= tipoAlteracao %>" />

                    <label
                        for="novoValor"
                        style="font-weight: bold; margin-bottom: 10px; display: block"
                    >
                        <%= tipoAlteracao === 'email' ? `Digite o NOVO E-mail:` : `Digite a NOVA
                        Senha:` %>
                    </label>

                    <div class="<%= tipoAlteracao === 'email' ? 'campo-email' : 'campo-senha' %>">
                        <input
                            type="<%= tipoAlteracao === 'email' ? 'email' : 'password' %>"
                            name="novoValor"
                            id="novoValor"
                            required
                            placeholder="<%= tipoAlteracao === 'email' ? 'novo@email.com' : 'Sua nova senha' %>"
                            style="
                                width: 100%;
                                padding: 10px;
                                margin-bottom: 20px;
                                border-radius: 5px;
                                border: 1px solid #ccc;
                                box-sizing: border-box;
                            "
                        />

                        <% if (tipoAlteracao === 'email') { %>
                        <p
                            class="aviso-senhas"
                            id="aviso-email"
                            aria-live="polite"
                            style="margin-top: -15px; margin-bottom: 15px"
                        ></p>
                        <% } else if (tipoAlteracao === 'senha') { %>
                        <ul
                            class="requisitos-senha"
                            id="requisitos-senha"
                            style="margin-top: -15px; margin-bottom: 15px"
                        >
                            <li id="req-tamanho" class="requisito">
                                <span class="icone">✗</span>
                                8 caracteres
                            </li>
                            <li id="req-maiuscula" class="requisito">
                                <span class="icone">✗</span>
                                1 letra maiúscula
                            </li>
                            <li id="req-numero" class="requisito">
                                <span class="icone">✗</span>
                                1 número
                            </li>
                        </ul>
                        <% } %>
                    </div>

                    <div class="cadastro-botao" style="display: flex; align-items: center">
                        <a href="/alterar-info" class="link-voltar">Voltar</a>
                        <button type="submit" class="botao-pronto">Enviar Código</button>
                    </div>
                </form>

                <script>
                    const tipo = '<%= tipoAlteracao %>';
                    const inputNovo = document.getElementById('novoValor');
                    const formAlterar = document.getElementById('form-alterar');

                    if (tipo === 'email') {
                        const avisoEmail = document.getElementById('aviso-email');

                        inputNovo.addEventListener('input', function () {
                            const val = inputNovo.value;
                            if (val === '') {
                                avisoEmail.textContent = '';
                                avisoEmail.className = 'aviso-senhas';
                                return;
                            }
                            const emailValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
                            if (emailValido) {
                                avisoEmail.textContent = '✓ E-mail válido';
                                avisoEmail.className = 'aviso-senhas ok';
                            } else {
                                avisoEmail.textContent = '✗ E-mail inválido';
                                avisoEmail.className = 'aviso-senhas erro';
                            }
                        });

                        formAlterar.addEventListener('submit', function (e) {
                            const emailValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(inputNovo.value);
                            if (!emailValido) {
                                e.preventDefault();
                                alert('Por favor, insira um e-mail válido antes de continuar.');
                            }
                        });
                    } else if (tipo === 'senha') {
                        const reqTamanho = document.getElementById('req-tamanho');
                        const reqMaiuscula = document.getElementById('req-maiuscula');
                        const reqNumero = document.getElementById('req-numero');

                        function verificarRequisito(elemento, ok) {
                            const icone = elemento.querySelector('.icone');
                            if (ok) {
                                elemento.classList.add('ok');
                                icone.textContent = '✓';
                            } else {
                                elemento.classList.remove('ok');
                                icone.textContent = '✗';
                            }
                        }

                        inputNovo.addEventListener('input', function () {
                            const val = inputNovo.value;
                            verificarRequisito(reqTamanho, val.length >= 8);
                            verificarRequisito(reqMaiuscula, /[A-Z]/.test(val));
                            verificarRequisito(reqNumero, /[0-9]/.test(val));
                        });

                        formAlterar.addEventListener('submit', function (e) {
                            const val = inputNovo.value;
                            const valido =
                                val.length >= 8 && /[A-Z]/.test(val) && /[0-9]/.test(val);
                            if (!valido) {
                                e.preventDefault();
                                alert('A sua nova senha não atende a todos os requisitos.');
                            }
                        });
                    }
                </script>

                <% } else if (etapa === 'confirmar') { %>
                <p>
                    Enviamos um código para o seu e-mail. Informe-o para confirmar a alteração de
                    <b><%= tipoAlteracao %></b>
                    .
                </p>
                <br />
                <form action="/alterar-info/confirmar" method="POST">
                    <input type="hidden" name="tipoAlteracao" value="<%= tipoAlteracao %>" />
                    <input type="hidden" name="novoValor" value="<%= novoValor %>" />

                    <label for="codigo">Código de Confirmação:</label>
                    <input
                        type="text"
                        name="codigo"
                        id="codigo"
                        maxlength="6"
                        required
                        placeholder="123456"
                        style="
                            width: 100%;
                            padding: 8px;
                            margin-bottom: 15px;
                            font-size: 1.5rem;
                            text-align: center;
                            letter-spacing: 5px;
                        "
                    />

                    <div class="cadastro-botao" style="display: flex; align-items: center">
                        <a href="/alterar-info" class="link-voltar">Cancelar</a>
                        <button type="submit" class="botao-pronto">Confirmar</button>
                    </div>
                </form>

                <% } else if (etapa === 'sucesso') { %>
                <div style="text-align: center">
                    <h2 style="color: #27ae60; margin-bottom: 15px">Alteração concluída!</h2>
                    <p>Seus dados foram atualizados com sucesso.</p>
                    <a href="/perfil" class="btn-principal" style="margin-top: 20px">
                        Voltar para o Perfil
                    </a>
                </div>
                <% } %>
            </main>
        </div>
    </body>
</html>
