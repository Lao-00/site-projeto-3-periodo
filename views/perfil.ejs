<!DOCTYPE html>
<html lang="pt">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Perfil</title>
        <link rel="stylesheet" href="/css/style.css" />
    </head>
    <body class="perfil-body">
        <header class="header"><%- include('partials/navbar') %></header>
        <main id="conteudo-perfil" class="main" tabindex="-1">
            <div class="perfil-container">
                <h2>Seu Perfil</h2>

                <div class="perfil-info">
                    <h4 class="rotulo">Nome de Usuário</h4>
                    <div class="valor"><%= dados.nome %></div>
                </div>

                <div class="perfil-info">
                    <h4 class="rotulo">E-mail</h4>
                    <div class="valor"><%= dados.email %></div>
                </div>

                <div class="perfil-info">
                    <h4 class="rotulo">CPF</h4>
                    <div class="valor"><%= dados.cpf ? dados.cpf : 'Não informado' %></div>
                </div>

                <div class="perfil-botoes-container" style="gap: 20px; align-items: center">
                    <a href="/" class="link-voltar">Voltar</a>
                    <a href="/alterar-info" class="btn-perfil">Alterar Email/Senha</a>
                </div>
            </div>
        </main>
        <div vw class="enabled">
            <div vw-access-button class="active"></div>
            <div vw-plugin-wrapper>
                <div class="vw-plugin-top-wrapper"></div>
            </div>
        </div>
        <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
        <script>
            new window.VLibras.Widget('https://vlibras.gov.br/app');
        </script>
    </body>
</html>
